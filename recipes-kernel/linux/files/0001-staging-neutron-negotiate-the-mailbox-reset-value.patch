From 64abaf237cd055e21e2e7ce77016aee176dcd787 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?S=C3=A9bastien=20Taylor?= <sebastien@au-zone.com>
Date: Thu, 15 Oct 2026 17:22:16 +0000
Subject: [PATCH] staging: neutron: negotiate the mailbox reset value
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Backport the mailbox handshake from the 6.18.37 BSP so the driver works
with eIQ Neutron SDK 3.2.x firmware. 3.2.x replies 0xA1 to a reset where
this driver expects 0x0 and would spin until its retry budget ran out,
leaving the NPU unusable.

The reset reply is no longer a compile-time constant: the driver starts
at RESET_VAL (0xA1) and falls back to RESET_VAL_OLD (0x0) when the
firmware answers with it, so one kernel drives either generation of
runtime and 3.1.x boards keep working.

Also write POLL to MBOX3 ahead of the arguments in both the send and
reset paths, closing a race where the firmware woke on the argument
writes and read a stale request, and read the return code directly in
the rx callback.

Upstream-Status: Backport [https://github.com/nxp-imx/linux-imx lf-6.18.37-2.1.0]
Signed-off-by: Sébastien Taylor <sebastien@au-zone.com>
---
 drivers/staging/neutron/neutron_device.h  |  4 +++-
 drivers/staging/neutron/neutron_mailbox.c | 26 +++++++++++++++++------
 drivers/staging/neutron/neutron_mailbox.h |  6 ++++++
 3 files changed, 28 insertions(+), 8 deletions(-)

diff --git a/drivers/staging/neutron/neutron_device.h b/drivers/staging/neutron/neutron_device.h
index fc40b2d..5f6fd5b 100644
--- a/drivers/staging/neutron/neutron_device.h
+++ b/drivers/staging/neutron/neutron_device.h
@@ -65,9 +65,11 @@
 #define DM_ACK    0xDA3
 #define DONE      0xAD0
 #define DM_DONE   0xDAD
-#define RESET_VAL 0x0
+#define RESET_VAL 0xA1
+#define RESET_VAL_OLD 0x0
 
 // values received from SoC (first driver mbox)
+#define POLL            0x9011
 #define RUN             0x269
 #define CLEAR_FW_LOG    0x270
 #define GET_FW_LOGLEVEL 0x271
diff --git a/drivers/staging/neutron/neutron_mailbox.c b/drivers/staging/neutron/neutron_mailbox.c
index da167f2..60a984b 100644
--- a/drivers/staging/neutron/neutron_mailbox.c
+++ b/drivers/staging/neutron/neutron_mailbox.c
@@ -90,6 +90,11 @@ static int mbox_send_data(struct neutron_mbox *mbox, void *data)
 		msg->argc = MAX_SEND_MSG_ARGC;
 	}
 
+	/* Write POLL first to wake firmware and signal "request incoming".
+	 * Prevents race where firmware wakes on argument writes and reads stale request.
+	 */
+	writel(POLL, mbox->base + MBOX3);
+
 	for (i = 0; i < msg->argc; i++)
 		writel(msg->args[i], mbox->base + SEND_MSG_ARG(i));
 
@@ -124,18 +129,24 @@ static int mbox_send_reset(struct neutron_mbox *mbox)
 {
 	u32 i, val;
 
-	writel(RESET_VAL, mbox->base + MBOX4);
-	writel(RESET_VAL, mbox->base + MBOX5);
+	/* Write POLL first to wake firmware and signal "request incoming". */
+	writel(POLL, mbox->base + MBOX3);
+	writel(mbox->reset_val, mbox->base + MBOX4);
+	writel(mbox->reset_val, mbox->base + MBOX5);
 	writel(RESET, mbox->base + MBOX3);
 
 	usleep_range(2, 5);
 	/* Wait for neutron to get into reset */
-	for (i = 0; i < 50; i++) {
+	for (i = 0; i < 20; i++) {
 		val = readl(mbox->base + MBOX0);
-		if (val != RESET_VAL)
-			usleep_range(2, 10);
-		else
+		if (val == RESET_VAL) {
+			mbox->reset_val = RESET_VAL;
+			return 0;
+		} else if (val == RESET_VAL_OLD) {
+			mbox->reset_val = RESET_VAL_OLD;
 			return 0;
+		}
+		usleep_range(2, 10);
 	}
 
 	return val;
@@ -181,7 +192,7 @@ static void mbox_recv_callback(struct neutron_mbox *mbox)
 {
 	struct neutron_mbox_rx_msg rx_msg;
 
-	mbox_recv_data(mbox, &rx_msg);
+	rx_msg.retcode = mbox_read_ret(mbox);
 
 	if (mbox->callback)
 		mbox->callback(mbox->ndev, &rx_msg);
@@ -265,6 +276,7 @@ struct neutron_mbox *neutron_mbox_create(struct neutron_device *ndev, int irq,
 
 	mbox->callback = callback;
 	mbox->ops = &neutron_mbox_ops;
+	mbox->reset_val = RESET_VAL;
 
 	ret = mbox_request_irq(mbox, mbox_irq_handler);
 	if (ret < 0) {
diff --git a/drivers/staging/neutron/neutron_mailbox.h b/drivers/staging/neutron/neutron_mailbox.h
index da88695..6100045 100644
--- a/drivers/staging/neutron/neutron_mailbox.h
+++ b/drivers/staging/neutron/neutron_mailbox.h
@@ -31,6 +31,12 @@ struct neutron_mbox {
 	struct neutron_device *ndev;
 	const struct neutron_mbox_ops *ops;
 	mbox_rx_callback callback;
+	/* Reset reply value expected from the firmware. Defaults to RESET_VAL
+	 * and is downgraded to RESET_VAL_OLD if an old neutron runtime is
+	 * detected during reset, keeping the new driver compatible with an
+	 * un-updated runtime on the board.
+	 */
+	u32 reset_val;
 };
 
 struct neutron_mbox_ops {
-- 
2.43.0

